<Application x:Class="StansploitOrionProject.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StansploitOrionProject"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BackgroundColor" Color="#0D0D14"/>
            <SolidColorBrush x:Key="SidebarColor" Color="#0D0D14"/>
            <SolidColorBrush x:Key="AccentColor" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="AccentColorBright" Color="#A78BFA"/>
            <SolidColorBrush x:Key="PanelBackground" Color="#16161F"/>
            <SolidColorBrush x:Key="PanelBorder" Color="#2A2A38"/>
            <SolidColorBrush x:Key="TextColor" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="MutedTextColor" Color="#8B8B9A"/>
            
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentColorBright}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
