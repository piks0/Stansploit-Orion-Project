<Window x:Class="StansploitOrionProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StansploitOrionProject"
        mc:Ignorable="d"
        Title="Stansploit Orion Project" Height="700" Width="1100">
    <Grid Background="{StaticResource BackgroundColor}">
        <!-- Welcome Screen Host -->
        <ContentControl x:Name="WelcomeHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- Main Shell Grid (Sidebar + Content) -->
        <Grid x:Name="MainShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#0A0A0A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Row="0" Margin="15,25,15,20">
                    <TextBlock FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource AccentColor}">
                        <Run Text="Stansploit"/>
                        <LineBreak/>
                        <Run Text="Orion Project"/>
                    </TextBlock>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource AccentColor}" Margin="0,0,0,20"/>

                <!-- Navigation Options -->
                <StackPanel Grid.Row="2" Margin="0,0" HorizontalAlignment="Stretch">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="25,12"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="Transparent" BorderThickness="4,0,0,0" BorderBrush="Transparent">
                                            <ContentPresenter Margin="20,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#150018"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="Dashboard" Click="Nav_Click" Tag="Dashboard"/>
                    <Button Content="Tweaks" Click="Nav_Click" Tag="Tweaks"/>
                    <Button Content="Installer" Click="Nav_Click" Tag="Installer"/>
                    <Button Content="Settings" Click="Nav_Click" Tag="Settings"/>
                </StackPanel>
            </Grid>


            <!-- Sidebar Right Border (Thin bright magenta/purple vertical border) -->
            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{StaticResource AccentColor}"/>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="30,25,30,30" HorizontalAlignment="Center" Width="700">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Title (Left-aligned relative to the main content container) -->
                <TextBlock x:Name="PageTitleText" Grid.Row="0" Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Main Content Container (Positioned and left-aligned matching the title anchor point) -->
                <ContentControl x:Name="MainContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

