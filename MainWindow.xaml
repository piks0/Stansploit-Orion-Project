<Window x:Class="StansploitOrionProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StansploitOrionProject"
        mc:Ignorable="d"
        Title="Stansploit Orion Project" Height="700" Width="1100">
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo Area -->
            <StackPanel Grid.Row="0" Margin="15,25,15,20">
                <TextBlock FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource AccentColor}">
                    <Run Text="Stansploit"/>
                    <LineBreak/>
                    <Run Text="Orion Project"/>
                </TextBlock>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource AccentColor}" Margin="0,0,0,20"/>

            <!-- Navigation Options -->
            <StackPanel Grid.Row="2" Margin="10,0" HorizontalAlignment="Center">
                <Button Content="Dashboard" Click="Nav_Click" Tag="Dashboard" HorizontalContentAlignment="Center" Margin="10,8" Padding="10,8"/>
                <Button Content="Power Plan" Click="Nav_Click" Tag="PowerPlan" HorizontalContentAlignment="Center" Margin="10,8" Padding="10,8"/>
                <Button Content="Installer" Click="Nav_Click" Tag="Installer" HorizontalContentAlignment="Center" Margin="10,8" Padding="10,8"/>
                <Button Content="Debloater" Click="Nav_Click" Tag="Debloater" HorizontalContentAlignment="Center" Margin="10,8" Padding="10,8"/>
                <Button Content="Experimental" Click="Nav_Click" Tag="Experimental" HorizontalContentAlignment="Center" Margin="10,8" Padding="10,8"/>
                <Button Content="Settings" Click="Nav_Click" Tag="Settings" HorizontalContentAlignment="Center" Margin="10,8" Padding="10,8"/>
            </StackPanel>
        </Grid>

        <!-- Sidebar Right Border (Thin bright magenta/purple vertical border) -->
        <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{StaticResource AccentColor}"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="30,25,30,30" HorizontalAlignment="Center" Width="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title (Left-aligned relative to the main content container) -->
            <TextBlock x:Name="PageTitleText" Grid.Row="0" Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

            <!-- Main Content Container (Positioned and left-aligned matching the title anchor point) -->
            <ContentControl x:Name="MainContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
