<UserControl x:Class="StansploitOrionProject.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="700">
    <UserControl.Resources>
        <!-- Progress Bar Style for Metrics -->
        <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="Background" Value="#2A2A38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" 
                                           Fill="{TemplateBinding Foreground}" 
                                           RadiusX="3" RadiusY="3"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,30,0,20" HorizontalAlignment="Stretch" MaxWidth="800">
        <!-- ===================== HARDWARE CARD ===================== -->
        <TextBlock Text="HARDWARE" Foreground="{StaticResource MutedTextColor}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Left"/>
        <Border Background="{StaticResource PanelBackground}" CornerRadius="20" Padding="30" Margin="0,0,0,40" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Column -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Viewbox Grid.Row="0" Width="24" Height="24" HorizontalAlignment="Center">
                        <Path Data="M4 4H7V7H4V4Z M8 4H11V7H8V4Z M12 4H15V7H12V4Z M4 8H7V11H4V8Z M8 8H11V11H8V8Z M12 8H15V11H12V8Z M4 12H7V15H4V12Z M8 12H11V15H8V12Z M12 12H15V15H12V12Z" 
                              Fill="{StaticResource AccentColorBright}" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="CPU" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CpuHardwareValue" Grid.Row="2" Text="Loading..." Foreground="{StaticResource TextColor}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- GPU Column -->
                <Grid Grid.Column="1" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Viewbox Grid.Row="0" Width="24" Height="24" HorizontalAlignment="Center">
                        <Path Data="M2 6H22V8H2V6Z M4 8H20V18H4V8Z M8 10H16V12H8V10Z" 
                              Fill="{StaticResource AccentColorBright}" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="GPU" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GpuHardwareValue" Grid.Row="2" Text="Loading..." Foreground="{StaticResource TextColor}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- RAM Column -->
                <Grid Grid.Column="2" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Viewbox Grid.Row="0" Width="24" Height="24" HorizontalAlignment="Center">
                        <Path Data="M3 8H21V16H3V8Z M5 6H19V8H5V6Z M7 10H9V14H7V10Z M15 10H17V14H15V10Z" 
                              Fill="{StaticResource AccentColorBright}" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="RAM" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RamHardwareValue" Grid.Row="2" Text="Loading..." Foreground="{StaticResource TextColor}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- OS Column -->
                <Grid Grid.Column="3" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Viewbox Grid.Row="0" Width="24" Height="24" HorizontalAlignment="Center">
                        <Path Data="M4 4H20V12H4V4Z M8 12H16V14H8V12Z M10 14H14V16H10V14Z" 
                              Fill="{StaticResource AccentColorBright}" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="OS" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OsHardwareValue" Grid.Row="2" Text="Loading..." Foreground="{StaticResource TextColor}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="OsStatusText" Text="" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== SYSTEM METRICS CARD ===================== -->
        <TextBlock Text="SYSTEM METRICS" Foreground="{StaticResource MutedTextColor}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Left"/>
        <Border Background="{StaticResource PanelBackground}" CornerRadius="20" Padding="20" Margin="0,0,0,20" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Usage Sub-card -->
                <Border Grid.Column="0" Background="#16161F" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M4 4H7V7H4V4Z M8 4H11V7H8V4Z M12 4H15V7H12V4Z M4 8H7V11H4V8Z M8 8H11V11H8V8Z M12 8H15V11H12V8Z M4 12H7V15H4V12Z M8 12H11V15H8V12Z M12 12H15V15H12V12Z" 
                                  Fill="{StaticResource AccentColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="CPU Usage" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CpuUsageText" Text="0.0%" Foreground="{StaticResource TextColor}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="CpuUsageProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" Value="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- GPU Usage Sub-card -->
                <Border Grid.Column="1" Background="#16161F" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M2 6H22V8H2V6Z M4 8H20V18H4V8Z M8 10H16V12H8V10Z" 
                                  Fill="{StaticResource AccentColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="GPU Usage" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="GpuUsageText" Text="N/A" Foreground="{StaticResource TextColor}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="GpuUsageProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" Value="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RAM Usage Sub-card -->
                <Border Grid.Column="2" Background="#16161F" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M3 8H21V16H3V8Z M5 6H19V8H5V6Z M7 10H9V14H7V10Z M15 10H17V14H15V10Z" 
                                  Fill="{StaticResource AccentColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="RAM Usage" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RamUsageText" Text="0.0 / 0.0 GB" Foreground="{StaticResource TextColor}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="RamUsageProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" Value="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Disk Usage Sub-card -->
                <Border Grid.Column="3" Background="#16161F" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M2 6H22V8H2V6Z M4 8H20V18H4V8Z M8 10H16V12H8V10Z" 
                                  Fill="{StaticResource AccentColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Disk Usage" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DiskUsageText" Text="0.0%" Foreground="{StaticResource TextColor}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="DiskUsageProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" Value="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Network Sub-card -->
                <Border Grid.Column="4" Background="#16161F" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="M12 2C8.69 2 6 4.69 6 8C6 11.31 8.69 14 12 14C15.31 14 18 11.31 18 8C18 4.69 15.31 2 12 2Z M12 16C10.34 16 9 17.34 9 19C9 20.66 10.34 22 12 22C13.66 22 15 20.66 15 19C15 17.34 13.66 16 12 16Z" 
                                  Fill="{StaticResource AccentColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Network" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NetUsageText" Text="Down 0.0 KB/s
Up 0.0 KB/s" Foreground="{StaticResource TextColor}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="NetworkUsageProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" Value="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== INFO STRIP ===================== -->
        <Border Background="{StaticResource PanelBackground}" CornerRadius="16" Padding="20" Margin="0,0,0,30" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Uptime Section -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="UPTIME" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="UptimeText" Text="00:00:00" Foreground="{StaticResource TextColor}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Power Plan Section -->
                <StackPanel Grid.Column="1" Margin="0,0,0,0">
                    <TextBlock Text="POWER PLAN" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" Margin="20,0,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PowerText" Text="Balanced" Foreground="{StaticResource TextColor}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="20,4,0,0"/>
                    <TextBlock x:Name="PowerStatusText" Text="" Foreground="{StaticResource MutedTextColor}" FontSize="11" HorizontalAlignment="Center" Margin="20,2,0,0"/>
                </StackPanel>

                <!-- Performance Section -->
                <StackPanel Grid.Column="2" Margin="0,0,0,0">
                    <TextBlock Text="PERFORMANCE" Foreground="{StaticResource MutedTextColor}" FontSize="12" FontWeight="Bold" Margin="20,0,0,0" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,4,0,0">
                        <TextBlock x:Name="CpuStatusText" Text="N/A" Foreground="{StaticResource TextColor}" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock x:Name="GpuStatusText" Text="N/A" Foreground="{StaticResource TextColor}" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock x:Name="RamStatusText" Text="N/A" Foreground="{StaticResource TextColor}" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== QUICK ACTIONS CARD ===================== -->
        <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource MutedTextColor}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Left"/>
        <Border Background="{StaticResource PanelBackground}" CornerRadius="20" Padding="30" Margin="0,0,0,10" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="TweaksButton" Click="GoToTweaks_Click" Padding="12,8" FontSize="14" Foreground="{StaticResource AccentColor}" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Path Data="M4 7H20 M7 4V10 M17 4V10 M6 12H18 M9 15H15" 
                                  Stroke="{StaticResource AccentColor}" StrokeThickness="1.8" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Tweaks" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="InstallerButton" Click="GoToInstaller_Click" Padding="12,8" FontSize="14" Foreground="{StaticResource AccentColor}" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Path Data="M12 3V16 M12 16L8 12 M12 16L16 12 M5 19H19" 
                                  Stroke="{StaticResource AccentColor}" StrokeThickness="1.8" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Installer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TaskManagerButton" Click="OpenTaskManager_Click" Padding="12,8" FontSize="14" Foreground="{StaticResource AccentColor}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Path Data="M4 6H20V8H4V6Z M4 10H16V12H4V10Z M4 14H12V16H4V14Z M4 18H16V20H4V18Z" 
                                  Fill="{StaticResource AccentColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Task Manager" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
